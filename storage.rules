rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /snapshots/{uid}/{workspaceId}/{fileName} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && fileName.matches('rev_[0-9]+[.]json')
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/json'
        && request.resource.metadata.keys().hasOnly([
          'workspaceId', 'schoolId', 'revision'
        ])
        && request.resource.metadata.workspaceId == workspaceId
        && request.resource.metadata.schoolId is string
        && request.resource.metadata.revision is string;
      allow delete: if isOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
