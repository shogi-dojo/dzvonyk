# Every VITE_* value is compiled into the browser bundle and is public.
# Never put service-account keys, OAuth client secrets, private API keys, or
# other server credentials here.

# Required Firebase Web configuration. `npm run build:firebase` obtains these
# values from the active Firebase project and injects them without writing a file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Required environment-specific application configuration.
VITE_FIREBASE_FUNCTIONS_REGION=
VITE_FEEDBACK_EMAIL=

# Optional. Leave blank to disable the corresponding integration or UI.
VITE_RECAPTCHA_SITE_KEY=
VITE_DONATE_URL=
VITE_USE_FIREBASE_EMULATOR=false
